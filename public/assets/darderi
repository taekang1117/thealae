<!DOCTYPE html>
<html lang="ko">

<head>
 <meta charset="UTF-8">
 <title>XGB 2.12.0</title>
 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="/static/css/main.css">
 <link rel="stylesheet" href="/static/css/index.css">
</head>

<body>

 <template id="kalshiOrderHistoryTemplate">
  
  
  
  


<div class="kalshi-order-history-row khist-root" id="kalshiOrderHistoryRoot" data-history-root>
  <div class="kalshi-order-history-header">
    <div id="kalshiOrderHistoryTitle" class="kalshi-order-history-title" title="Shows the latest 5 order(s) sorted by creation time">Order History</div>
    <div class="kalshi-order-history-controls">
      
      <label class="kalshi-order-history-auto-label" for="kalshiOrderHistoryAutoRefresh">
        <input id="kalshiOrderHistoryAutoRefresh" type="checkbox" checked>
        <span>Auto</span>
        <span id="kalshiOrderHistoryAutoHint" class="kalshi-order-history-auto-hint"></span>
      </label>
      <label for="kalshiOrderHistoryLimit" class="kalshi-order-history-limit-label">Last</label>
      <input id="kalshiOrderHistoryLimit" class="kalshi-order-history-limit-input" type="number" min="1" max="100" step="1" value="5">
      <button id="kalshiOrderHistoryUpdateBtn" type="button" class="kalshi-order-history-update">Update</button>
    </div>
  </div>
  <div id="kalshiOrderHistoryEnvironment" class="kalshi-order-history-env"></div>
  <div id="kalshiOrderHistoryMeta" class="kalshi-order-history-meta"></div>
  <div id="kalshiOrderHistorySummary" class="kalshi-order-history-summary"></div>
  <div class="khist-bar">
    
    <label id="kalshiOrderHistoryFilter" class="kalshi-order-history-filter">
      <input id="kalshiOrderHistoryTickerOnly" type="checkbox">
      <span id="kalshiOrderHistoryFilterText">Only this ticker</span>
    </label>
    
    <div id="kalshiOrderHistoryStatus" class="kalshi-order-history-status">Click Update to load recent orders.</div>
  </div>
  <div id="kalshiOrderHistoryList" class="kalshi-order-history-list"></div>
</div>
 </template>

 <template id="polyOrderHistoryTemplate">
  
  
  
  


<div class="kalshi-order-history-row khist-root" id="polyOrderHistoryRoot" data-history-root>
  <div class="kalshi-order-history-header">
    <div id="polyOrderHistoryTitle" class="kalshi-order-history-title" title="Shows the latest 10 order(s) sorted by creation time">Order History</div>
    <div class="kalshi-order-history-controls">
      
      <label class="kalshi-order-history-auto-label" for="polyOrderHistoryAutoRefresh">
        <input id="polyOrderHistoryAutoRefresh" type="checkbox" checked>
        <span>Auto</span>
        <span id="polyOrderHistoryAutoHint" class="kalshi-order-history-auto-hint"></span>
      </label>
      <label for="polyOrderHistoryLimit" class="kalshi-order-history-limit-label">Last</label>
      <input id="polyOrderHistoryLimit" class="kalshi-order-history-limit-input" type="number" min="1" max="100" step="1" value="10">
      <button id="polyOrderHistoryUpdateBtn" type="button" class="kalshi-order-history-update">Update</button>
    </div>
  </div>
  <div id="polyOrderHistoryEnvironment" class="kalshi-order-history-env"></div>
  <div id="polyOrderHistoryMeta" class="kalshi-order-history-meta"></div>
  <div id="polyOrderHistorySummary" class="kalshi-order-history-summary"></div>
  <div class="khist-bar">
    
    <div id="polyOrderHistoryStatus" class="kalshi-order-history-status">Click Update to load recent orders.</div>
  </div>
  <div id="polyOrderHistoryList" class="kalshi-order-history-list"></div>
</div>
 </template>

 <nav class="quicknav" aria-label="Quick navigation">
  <button type="button" id="quicknavSearch" class="quicknav-btn" title="Jump to search (top)" aria-label="Jump to search">
   <span class="quicknav-icon" aria-hidden="true">&#9650;</span>
  </button>
  <button type="button" id="quicknavHome" class="quicknav-btn" title="Jump to Predicted Winner" aria-label="Jump to Predicted Winner">
   <span class="quicknav-icon quicknav-icon-dot" aria-hidden="true"></span>
  </button>
  <button type="button" id="quicknavDashboard" class="quicknav-btn" title="Jump to Kalshi Market Analysis (bottom)" aria-label="Jump to Kalshi Market Analysis">
   <span class="quicknav-icon" aria-hidden="true">&#9660;</span>
  </button>
 </nav>

 <div class="container">
  <div class="header">
      <div id="marketVenueSwitch" class="market-venue-switch" role="radiogroup" aria-label="Market venue">
        <div class="venue-radio-group">
         <label class="venue-radio-item">
          <input type="radio" name="venueMode" value="polymarket" checked>
          <span>POLY</span>
         </label>
         <label class="venue-radio-item">
          <input type="radio" name="venueMode" value="kalshi">
          <span>KALSHI</span>
         </label>
        </div>
      </div>
      <div class="header-main">
        <h1>XGB 2.12.0</h1>
      </div>
      <div class="tour-switch-compact">
        <span id="activeTourBadge" class="tour-badge">Tour</span>
        <div class="tour-radio-group">
          <label class="tour-radio-item">
            <input type="radio" name="tourMode" value="ATP" checked>
            <span>ATP</span>
          </label>
          <label class="tour-radio-item">
            <input type="radio" name="tourMode" value="WTA" >
            <span>WTA</span>
          </label>
        </div>
      </div>
      <div class="player-search-wrap">
        <div class="player-search">
          <input id="playerSearchInput" type="search" class="player-search-input"
            placeholder="Search player name" autocomplete="off"
            aria-label="Search player name">
          <button id="playerSearchClear" type="button" class="player-search-clear"
            aria-label="Clear search" hidden>×</button>
        </div>
        <div id="playerSearchCount" class="player-search-count" aria-live="polite"></div>
      </div>
    </div>

    <div id="notifyOpenMarketsPanel" class="notify-open-markets-panel" aria-live="polite">
   <details id="notifyOpenMarketsDetails" class="notify-open-markets-details" open>
    <summary id="notifyOpenMarketsSummary" class="notify-open-markets-summary">
     <div class="notify-open-markets-header">
      <div id="notifyOpenMarketsTitle" class="notify-open-markets-title">Open Markets</div>
      <div class="notify-open-markets-summary-meta">
       <div id="notifyOpenMarketsUpdated" class="notify-open-markets-updated"></div>
       <span id="notifyOpenMarketsToggleAction" class="notify-open-markets-toggle-action">(click to
        collapse)</span>
       <span class="notify-open-markets-chevron">▸</span>
      </div>
     </div>
    </summary>
    <div id="notifyOpenMarketsSection" class="notify-open-markets-section"></div>
   </details>
  </div>

  <div class="card">
   <details id="matchConfigDetails" class="collapsible-details">
    <summary class="collapsible-summary">
     <span class="collapsible-title">Match Configuration</span>
     <span class="collapsible-right">
      <span id="matchConfigToggleAction" class="collapsible-action">(click to expand)</span>
      <span class="collapsible-chevron">▸</span>
     </span>
    </summary>
    <div class="collapsible-content">
   <form id="mainForm" method="GET">
    <div class="grid">
     <!-- 1행: A 이름 / A 랭킹 -->
     <div class="field">
      <div class="labelrow">
       <label>Player A Name</label>
      </div>
      <div id="A_combobox" class="player-combobox" role="combobox" aria-expanded="false" aria-haspopup="listbox"
       aria-owns="A_listbox" aria-controls="A_listbox" aria-activedescendant="">
       <input class="searchbox player-combobox-input" id="A_search" placeholder="Search and select a player"
        autocomplete="off" role="searchbox" aria-autocomplete="list" aria-controls="A_listbox"
        aria-activedescendant="">
       <div id="A_listbox" class="player-combobox-list" role="listbox"></div>
      </div>
      <select id="A_name" name="A_name" class="player-select-hidden"></select>
     </div>

     <div class="field">
      <div class="labelrow">
       <label>A Ranking</label>
      </div>
      <div class="input-with-note">
       <input id="A_rank" name="A_rank" value="" placeholder="e.g., 120" class="rank-input">
       <div id="A_rank_text" class="rank-note"></div>
      </div>
      
     </div>

     <!-- 2행: B 이름 / B 랭킹 -->
     <div class="field">
      <div class="labelrow">
       <label>Player B Name</label>
      </div>
      <div id="B_combobox" class="player-combobox" role="combobox" aria-expanded="false" aria-haspopup="listbox"
       aria-owns="B_listbox" aria-controls="B_listbox" aria-activedescendant="">
       <input class="searchbox player-combobox-input" id="B_search" placeholder="Search and select a player"
        autocomplete="off" role="searchbox" aria-autocomplete="list" aria-controls="B_listbox"
        aria-activedescendant="">
       <div id="B_listbox" class="player-combobox-list" role="listbox"></div>
      </div>
      <select id="B_name" name="B_name" class="player-select-hidden"></select>
     </div>

     <div class="field">
      <div class="labelrow">
       <label>B Ranking</label>
      </div>
      <div class="input-with-note">
       <input id="B_rank" name="B_rank" value="" placeholder="e.g., 85" class="rank-input">
       <div id="B_rank_text" class="rank-note"></div>
      </div>
      
     </div>

     <!-- 3행: Surface / Tournament -->
     <div class="field">
      <div class="labelrow">
       <label>Surface</label>
      </div>
      <select id="surface" name="surface">
       <option value="">-- Select --</option>
       
       <option value="HARD" >HARD</option>
       
       <option value="CLAY" selected>CLAY</option>
       
       <option value="GRASS" >GRASS</option>
       
       <option value="CARPET" >CARPET</option>
       
       <option value="UNKNOWN" >UNKNOWN</option>
       
      </select>
     </div>

     <div class="field">
      <div class="labelrow">
       <label>Tournament</label>
      </div>
      <select id="tournament" name="tournament" data-selected="">
       <option value="">-- Select --</option>
      </select>
     </div>

     <!-- 4행: Market-k / Market A% -->
     <div class="field">
      <div class="labelrow">
       <label class="label">Market-k</label>
      </div>
      <input id="market_k" name="market_k" value=""
       placeholder="default: none" class="rank-input">
     </div>

     <div class="field">
      <div class="labelrow">
       <label class="label">Market A%</label>
      </div>
      <input id="market_p_a" name="market_p_a" value="" placeholder="e.g., 52.5"
       class="rank-input">
     </div>

     <!-- 5행: Predict out / Train data_dir override -->
     <div class="field">
      <div class="labelrow">
       <label class="label">Args (--out_dir)</label>
      </div>
      <select id="out_dir" name="out_dir">
       <option value="auto" selected>Auto (ATP: out, WTA: out2)</option>
       <option value="out" >out</option>
       <option value="out2" >out2</option>
      </select>
     </div>

     <div class="field">
      <div class="labelrow">
       <label class="label">Args (--data_dir)</label>
      </div>
      <select id="train_data_dir" name="train_data_dir">
       <option value="auto" selected>Auto (data_cleaned)</option>
       <option value="data_cleaned" >data_cleaned
       </option>
       <option value="data_cleaned2" >data_cleaned2
       </option>
      </select>
     </div>

    </div>

    <!-- 버튼 영역 -->
    <div class="actions">
     <div class="actions-left">
      <button id="openBatchBtn" type="button" onclick="openAutoBatchOrder()">Batch Order</button>
     </div>

     <div class="actions-right">
      <div id="disableReason" class="disable_reason"></div>
      <button id="predictBtn" type="button" disabled>Prediction</button>
     </div>
    </div>
   </form>
    </div>
   </details>
  </div>

  <div id="analysisResultsCard" class="result-cards" style="display:none;">
   <div id="predictionResultsCard" class="card">
    <details id="predictionResultsDetails" class="collapsible-details" open>
     <summary class="collapsible-summary">
      <span class="collapsible-title">Prediction Result</span>
      <span class="collapsible-right">
       <span id="predictionResultsToggleAction" class="collapsible-action">(click to collapse)</span>
       <span class="collapsible-chevron">▸</span>
      </span>
     </summary>
     <div class="collapsible-content">

    <!-- 스트리밍 인디케이터 -->
    <div id="streamingIndicator" class="streaming-indicator"></div>

    <!-- Formatted Analysis Output -->
    <div id="analysisOutput">
     <p class="muted">Enter player names or rankings and click "Prediction". Run "Training" first only if prediction
      artifacts are missing.</p>
    </div>

    <div class="prediction-results-footer">
     <div class="raw-output-toggle">
      <div class="raw-output-right">
       <button id="toggleRawBtn" type="button" onclick="toggleRawOutput()">Show Raw Output</button>
      </div>
     </div>
     <div id="rawOutput"></div>
    </div>

    <!-- Hidden pre element for compatibility -->
    <pre id="output" style="display:none;">No results yet.</pre>
     </div>
    </details>
   </div>

   <div id="kalshiMarketCard" class="card">
    <details id="kalshiMarketDetails" class="collapsible-details" open>
     <summary class="collapsible-summary">
      <span class="collapsible-title">Market Analysis</span>
      <span class="collapsible-right">
       <span id="kalshiMarketToggleAction" class="collapsible-action">(click to collapse)</span>
       <span class="collapsible-chevron">▸</span>
      </span>
     </summary>
     <div class="collapsible-content">
      <div id="kalshiMarketCardBody" class="kalshi-market-card-body">
       <div id="kalshiMarketEdgeHost" class="kalshi-market-host" hidden></div>
       <div id="kalshiMarketOrderHost" class="kalshi-market-host" hidden></div>
      </div>
     </div>
    </details>
   </div>
  </div>

 <div id="kalshiOrderLogContainer">
   <div class="kalshi-order-log-toggle">
    <div class="kalshi-order-log-actions-left">
     <a class="exit-monitor-link-btn" href="/exit-monitor?env=production" target="_blank" rel="noopener">Exit Monitor</a>
    </div>
    <div class="kalshi-order-log-actions-right">
     <button id="toggleKalshiOrderLogBtn" type="button">Show Order Log</button>
    </div>
   </div>
   <div id="kalshiOrderLogOutput"></div>
  </div>
 </div>

 <div id="kalshiConfigModalBackdrop" class="app-modal-backdrop" hidden>
  <div class="app-modal-card" role="dialog" aria-modal="true" aria-labelledby="kalshiConfigModalTitle"
   aria-describedby="kalshiConfigModalBody">
   <h3 id="kalshiConfigModalTitle" class="app-modal-title">Kalshi Credential Notice</h3>
   <div id="kalshiConfigModalBody" class="app-modal-body"></div>
   <div class="app-modal-actions">
    <button id="kalshiConfigModalTertiary" type="button" class="app-modal-close" hidden>Cancel</button>
    <button id="kalshiConfigModalSecondary" type="button" class="app-modal-close" hidden>Cancel</button>
    <button id="kalshiConfigModalClose" type="button" class="app-modal-close">Close</button>
   </div>
  </div>
 </div>

 <div id="rankAutofillToastA" class="rank-autofill-toast" role="status" aria-live="polite" aria-atomic="true"></div>
 <div id="rankAutofillToastB" class="rank-autofill-toast" role="status" aria-live="polite" aria-atomic="true"></div>
 <div id="rankAutofillToastGlobal" class="rank-autofill-toast" role="status" aria-live="polite" aria-atomic="true">
 </div>

