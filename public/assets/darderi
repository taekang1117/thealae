// Order History 자동 갱신 주기(초). 세 개의 히스토리(index Kalshi / index PMUS /
// batch)가 같은 history.html 파셜을 쓰므로 주기도 여기 한 곳에서 관리한다.
const SHARED_KALSHI_ORDER_HISTORY_AUTO_REFRESH_SEC = 15;

// prefix -> {tickTimer, hintTimer, nextAtMs}. 모듈 레벨에 두는 이유:
// Kalshi/PMUS 히스토리 박스는 렌더될 때마다 <template>에서 새로 clone되므로,
// 이전 타이머를 정리하지 않으면 인터벌이 렌더 횟수만큼 쌓여 15초마다 N번 요청이 나간다.
const _sharedKalshiOrderHistoryAutoTimers = {};

// 기본값 ON: 사용자가 명시적으로 끈 경우('0')에만 꺼진 상태로 복원한다.
// localStorage를 못 읽는 환경(사생활 보호 모드 등)에서도 기본 ON을 유지한다.
function readSharedKalshiOrderHistoryAutoRefreshEnabled(storageKey) {
 try {
  return localStorage.getItem(storageKey) !== '0';
 } catch (_e) {
  return true;
 }
}

function clearSharedKalshiOrderHistoryAutoRefresh(prefix) {
 const key = String(prefix || '').trim();
 const prev = _sharedKalshiOrderHistoryAutoTimers[key];
 if (!prev) return;
 if (prev.tickTimer) clearInterval(prev.tickTimer);
 if (prev.hintTimer) clearInterval(prev.hintTimer);
 // change 핸들러도 반드시 떼어낸다. batch 페이지처럼 체크박스가 재생성되지 않는
 // (= 리스너가 엘리먼트와 함께 사라지지 않는) 경우, 같은 체크박스에 wire가 두 번
 // 걸리면 핸들러가 누적되고 각 핸들러가 자기 클로저의 stale state로 setInterval을
 // 다시 걸어 registry가 추적하지 못하는 타이머가 영구히 남는다.
 if (prev.checkbox && prev.onChange) {
  try { prev.checkbox.removeEventListener('change', prev.onChange); } catch (_e) { }
 }
 delete _sharedKalshiOrderHistoryAutoTimers[key];
}

// history.html의 Auto 체크박스를 refresh 함수에 연결한다.
// config: { prefix, root, checkbox, hintEl, refresh, intervalSec?, storageKey? }
function wireSharedKalshiOrderHistoryAutoRefresh(config = {}) {
 const cfg = (config && typeof config === 'object') ? config : {};
 const prefix = String(cfg.prefix || '').trim();
 const root = cfg.root || null;
 const checkbox = cfg.checkbox || null;
 const hintEl = cfg.hintEl || null;
 const refresh = (typeof cfg.refresh === 'function') ? cfg.refresh : null;
 if (!prefix || !root || !checkbox || !refresh) return null;

 const intervalSec = Math.max(
  5,
  Math.floor(Number(cfg.intervalSec) || SHARED_KALSHI_ORDER_HISTORY_AUTO_REFRESH_SEC)
 );
 const intervalMs = intervalSec * 1000;
 const storageKey = String(cfg.storageKey || `${prefix}AutoRefreshEnabled`);

 clearSharedKalshiOrderHistoryAutoRefresh(prefix);
 const state = { tickTimer: null, hintTimer: null, nextAtMs: null, checkbox, onChange: null };
 _sharedKalshiOrderHistoryAutoTimers[prefix] = state;

 const idleHint = `every ${intervalSec}s`;
 const renderHint = () => {
  if (!hintEl) return;
  if (!checkbox.checked || state.nextAtMs === null) {
   hintEl.textContent = idleHint;
   return;
  }
  hintEl.textContent = `${Math.max(0, Math.ceil((state.nextAtMs - Date.now()) / 1000))}s`;
 };
 const stop = () => {
  if (state.tickTimer) { clearInterval(state.tickTimer); state.tickTimer = null; }
  if (state.hintTimer) { clearInterval(state.hintTimer); state.hintTimer = null; }
  state.nextAtMs = null;
 };
 const isDetached = () => !document.body.contains(root);
 const start = () => {
  stop();
  state.nextAtMs = Date.now() + intervalMs;
  state.tickTimer = setInterval(() => {
   if (isDetached()) { stop(); return; }
   // 건너뛰든 말든 한 주기는 소비된 것으로 본다(카운트다운이 멈추지 않게).
   state.nextAtMs = Date.now() + intervalMs;
   // 백그라운드 탭에서는 실시간성이 의미 없으므로 요청을 아낀다.
   if (document.hidden) return;
   // "Last N"을 타이핑하는 중이면 건너뛴다: 갱신이 입력값을 정규화해 덮어쓴다.
   const active = document.activeElement;
   if (active && root.contains(active) && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) return;
   void refresh();
  }, intervalMs);
  state.hintTimer = setInterval(() => {
   if (isDetached()) { stop(); return; }
   renderHint();
  }, 1000);
 };
 const apply = (enabled) => {
  checkbox.checked = Boolean(enabled);
  try { localStorage.setItem(storageKey, checkbox.checked ? '1' : '0'); } catch (_e) { }
  if (checkbox.checked) start(); else stop();
  renderHint();
 };

 const onChange = () => {
  apply(checkbox.checked);
  if (checkbox.checked) void refresh();
 };
 state.onChange = onChange;
 checkbox.addEventListener('change', onChange);
 apply(readSharedKalshiOrderHistoryAutoRefreshEnabled(storageKey));
 return { apply, stop, renderHint };
}

function syncSharedKalshiOrderHistoryTitle(titleEl, limitInput, defaultLimit = 5) {
 const n = normalizeSharedKalshiOrderHistoryLimit(limitInput, defaultLimit);
 if (titleEl) {
  titleEl.textContent = 'Order History';
  titleEl.title = `Shows the latest ${n} order(s) sorted by creation time`;
 }
 return n;
}

// MATCH column: split the Kalshi ticker into the pair code, the outcome leg and
// the event series
// (KXATPCHALLENGERMATCH-26JUL15NAPBAR-NAP -> { code: 'NAPBAR', outcome: 'NAP', event: 'CHALLENGER' }).
// The outcome leg is what distinguishes the two markets of one match — without
// it both sides of NAPBAR abbreviate to the same string and read as a single
// market that somehow settled both ways. Display only: all P&L and position
// state is keyed on the full ticker, never on these parts.
function deriveSharedKalshiOrderMatchParts(tickerRaw) {
 const ticker = String(tickerRaw || '').trim().toUpperCase();
 if (!ticker) return { code: 'N/A', outcome: '', event: '' };
 const segs = ticker.split('-');
 if (segs.length < 2) return { code: ticker, outcome: '', event: '' };
 const series = segs[0];
 const mid = segs[1] || '';
 const code = mid.replace(/^\d{1,2}[A-Z]{3}\d{2}/, '') || mid || ticker;
 const outcome = String(segs[2] || '').trim();
 let event = '';
 if (series.includes('CHALLENGER')) event = 'CHALLENGER';
 else if (series.includes('WTA')) event = 'WTA';
 else if (series.includes('ATP')) event = 'ATP';
 else event = series.replace(/^KX/, '').replace(/MATCH$/, '');
 return { code, outcome, event };
}

// Cents -> signed dollars, with '—' for a genuinely unknown value. null/undefined
// must NOT collapse to $0.00: "no P&L realized here" and "broke even here" are
// different claims and the panel exists to keep them apart.
function formatSharedKalshiPnlCentsOrDash(rawCents) {
 if (rawCents === null || rawCents === undefined || rawCents === '') return '—';
 const cents = Number(rawCents);
 if (!Number.isFinite(cents)) return '—';
 const rounded = Math.round(cents);
 const sign = rounded > 0 ? '+' : (rounded < 0 ? '-' : '');
 return `${sign}$${(Math.abs(rounded) / 100).toFixed(2)}`;
}

// RESULT column. The tag describes what happened to the POSITION, not what one
// fill would have been worth marked to final settlement — under the old rule a
// sell that banked +$17 printed LOSE the moment the market settled YES.
function sharedKalshiResultStateParts(stateRaw) {
 const state = String(stateRaw || '').trim().toUpperCase();
 const map = {
  CLOSED_WIN: ['CLOSED WIN', 'r-win', 'Position closed before resolution at a profit.'],
  CLOSED_LOSS: ['CLOSED LOSS', 'r-lose', 'Position closed before resolution at a loss.'],
  CLOSED_FLAT: ['CLOSED FLAT', 'r-flat', 'Position closed before resolution at break-even.'],
  SETTLED_WIN: ['SETTLED WIN', 'r-win', 'Contracts held to resolution and paid out.'],
  SETTLED_LOSS: ['SETTLED LOSS', 'r-lose', 'Contracts held to resolution and expired worthless.'],
  SETTLED_FLAT: ['SETTLED FLAT', 'r-flat', 'Held to resolution at break-even.'],
  OPEN: ['OPEN', 'r-pend', 'Position is still live in an unresolved market.'],
  RESTING: ['RESTING', 'r-pend', 'Order has not filled; no position taken.'],
  CANCELED: ['CANCELED', 'r-flat', 'Order was canceled without filling.'],
  DATA_GAP: ['DATA GAP', 'r-gap',
   'A sell here has no matching inventory anywhere in this market’s fill history. '
   + 'Excluded from P&L rather than booked as a short position.'],
 };
 const hit = map[state];
 if (hit) return { text: hit[0], cls: hit[1], title: hit[2] };
 return { text: state || 'UNKNOWN', cls: 'r-pend', title: 'Position state unavailable.' };
}

function sharedKalshiPnlClass(cents) {
 if (cents === null || cents === undefined || !Number.isFinite(Number(cents))) return 'pnl-none';
 const n = Math.round(Number(cents));
 return n > 0 ? 'pnl-pos' : (n < 0 ? 'pnl-neg' : 'pnl-none');
}

function normalizeSharedKalshiOrderHistoryNodeText(node) {
 if (!(node instanceof Node)) return node;
 if (node.nodeType === Node.TEXT_NODE) {
  const text = String(node.textContent || '').replace(/쨌/g, '\u00b7');
  node.textContent = text
   .replace(/夷\?/g, '\u00b7 ')
   .replace(/吏\?/g, '\u00a2')
   .replace(/\?\?Qty/g, '\u00b7 Qty')
   .replace(/Held \?\?/g, 'Held \u2014')
   .replace(/\?\?(?=[)\s]|$)/g, '\u2014');
  return node;
 }
 if (node.nodeType === Node.ELEMENT_NODE) {
  Array.from(node.childNodes).forEach((child) => normalizeSharedKalshiOrderHistoryNodeText(child));
 }
 return node;
}

