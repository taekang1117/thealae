  const statusRaw = String(o && o.status || '').trim().toLowerCase();
  const actionRaw = String(o && o.action || '').trim().toLowerCase();
  const actionLabel = actionRaw === 'sell' ? 'SELL' : 'BUY';
  const side = String(o && o.side || '').trim().toLowerCase();
  const sideTag = side === 'no' ? 'NO' : (side === 'yes' ? 'YES' : 'SIDE');
  const entryPriceInline = deriveKalshiOrderEntryPriceCents(o);
  const entryPriceTextInline = entryPriceInline !== null ? `${entryPriceInline}\u00a2` : '\u2014';
  const countNum = parseKalshiOrderNumber(o && o.count);
  const count = countNum !== null ? String(Math.round(countNum)) : '\u2014';

  const tickerKey = String(o && o.ticker || '').trim().toUpperCase();
  const ticker = tickerKey || 'ticker N/A';
  const orderId = String(o && o.order_id || '').trim() || 'N/A';
  const estimatedPnl = formatKalshiPnlCents(o && o.estimated_pl_cents);
  const realizedPnl = getRealizedPnlText(o, idx);
  const filledNum = parseKalshiOrderNumber(o && o.filled_count);
  const remainingNum = parseKalshiOrderNumber(o && o.remaining_count);
  const filled = filledNum !== null ? String(Math.round(filledNum)) : '\u2014';
  const remainingQty = remainingNum !== null ? Math.max(0, Math.round(remainingNum)) : 0;
  const heldQtyRaw = getKalshiPositionQtyBySide(holdingsMap, tickerKey, side);
  const heldQty = heldQtyRaw !== null ? Math.max(0, Math.round(heldQtyRaw)) : 0;
  let heldSuppressedByDuplicateTicker = false;
  let remainingSuppressedByDuplicateTicker = false;
  let heldNowText = getKalshiOrderHeldNowText(o, holdingsMap, { positionsApiOk });
  if (tickerKey) {
   if (heldShownTickers.has(tickerKey)) {
    heldNowText = /^Held\s+\d+$/.test(heldNowText) ? 'Held 0' : heldFallbackText;
    heldSuppressedByDuplicateTicker = true;
    if (remainingQty > 0) remainingSuppressedByDuplicateTicker = true;
   } else {
    heldShownTickers.add(tickerKey);
   }
  }
  const effectiveRemainingQty = remainingSuppressedByDuplicateTicker ? 0 : remainingQty;
  const remaining = remainingNum !== null ? String(effectiveRemainingQty) : '\u2014';
  const effectiveHeldQty = heldSuppressedByDuplicateTicker ? 0 : heldQty;
  const openValueCents = computeKalshiOrderOpenValueCents(o, effectiveHeldQty);
  const openValueText = openValueCents === null ? '$0.00' : formatKalshiPnlCents(openValueCents);
  const betUsd = formatKalshiOrderBetUsd(o);
  const matchTagRaw = String(o && o.match_tag || '').trim().toUpperCase();
  const matchTag = ['YES', 'NO', 'WAIT', 'LIVE', 'END', 'UNK'].includes(matchTagRaw) ? matchTagRaw : 'UNK';
  const outcome = deriveKalshiOrderOutcomeTag(matchTag, o && o.realized_pl_cents, effectiveHeldQty, openValueCents, statusRaw, actionRaw, filledNum);

  const tr = document.createElement('tr');
  if (statusRaw === 'resting') tr.classList.add('is-resting');
  if ((statusRaw === 'canceled' && effectiveHeldQty <= 0) || remainingSuppressedByDuplicateTicker) {
   tr.classList.add('is-canceled');
  }

  const timeCell = td('khist-time');
  timeCell.textContent = getTimeText(o, idx);
  tr.appendChild(timeCell);

  const sideCell = td();
  const actSpan = document.createElement('span');
  actSpan.className = `t-act ${statusRaw === 'canceled' ? 'cxl' : (actionRaw === 'sell' ? 'sell' : 'buy')}`;
  actSpan.textContent = actionLabel;
  sideCell.appendChild(actSpan);
  tr.appendChild(sideCell);

  const matchParts = deriveSharedKalshiOrderMatchParts(tickerKey);
  const matchCell = td('khist-match', ticker);
  const codeSpan = document.createElement('span');
  codeSpan.className = 'khist-code';
  codeSpan.textContent = matchParts.code;
  matchCell.appendChild(codeSpan);
  if (matchParts.outcome) {
   const outSpan = document.createElement('span');
   outSpan.className = 'khist-leg';
   outSpan.textContent = matchParts.outcome;
   matchCell.appendChild(outSpan);
  }
  if (matchParts.event) {
   const evSpan = document.createElement('span');
   evSpan.className = 'khist-ev';
   evSpan.textContent = matchParts.event;
   matchCell.appendChild(evSpan);
  }
  if (onTickerClick && tickerKey) {
   matchCell.classList.add('khist-match-link');
   matchCell.addEventListener('click', () => onTickerClick({ ticker: tickerKey, order: o, index: idx }));
  }
  tr.appendChild(matchCell);

  const fillCell = td('num');
  fillCell.textContent = `${sideTag} ${entryPriceTextInline}`;
  tr.appendChild(fillCell);

  // NOW: current market price for this order's own side (mid of the live book;
  // the settled payout once the market resolves), so a resting or open order
  // shows where the market is versus the price it was written at. Tinted
  // against the entry price — a BUY is green above entry, a SELL below it.
  const markNum = parseKalshiOrderNumber(o && o.mark_price_cents);
  const markCents = markNum !== null ? Math.round(markNum) : null;
  let markClass = 'pnl-none';
  let markTitle = 'Current market price unavailable.';
  if (markCents !== null) {
   markTitle = `Now ${markCents}¢ (${sideTag})`;
   if (entryPriceInline !== null) {
    const delta = markCents - entryPriceInline;
    const favorable = actionRaw === 'sell' ? -delta : delta;
    if (favorable > 0) markClass = 'pnl-pos';
    else if (favorable < 0) markClass = 'pnl-neg';
    const sign = delta > 0 ? '+' : '';
    markTitle += ` · entry ${entryPriceInline}¢ · ${sign}${delta}¢`;
   }
  }
  const markCell = td(`num ${markClass}`, markTitle);
  markCell.textContent = markCents !== null ? `${markCents}¢` : '—';
  tr.appendChild(markCell);

  // QTY is the FILLED contract count. It used to print the ORDERED count, so a
  // partially filled order showed 100 while every P&L figure derived from it \u2014
  // the match rollup, the header "Filled", net cash flow \u2014 used the 50 that
  // actually traded. Displayed quantities now sum to the header filled count by
  // construction; the unfilled remainder rides beside it as "+N".
  const qtyCell = td('num', `Ordered ${count} \u00B7 Filled ${filled} \u00B7 Remaining ${remaining} \u00B7 ${heldNowText}`);
  qtyCell.textContent = filled;
  if (effectiveRemainingQty > 0) {
   const restSpan = document.createElement('span');
   restSpan.className = 'khist-rest-qty';
   restSpan.textContent = `+${effectiveRemainingQty}`;
   qtyCell.appendChild(restSpan);
  }
  tr.appendChild(qtyCell);

  const betCell = td('num');
  betCell.textContent = betUsd;
  tr.appendChild(betCell);

  // TRADE P&L: what this order realized by CLOSING position, on the running
  // average cost basis \u2014 not this fill marked to final settlement. An opening
  // or adding order realizes nothing and prints '\u2014'; a canceled order never
  // traded and prints '\u2014' too.
  const tradePlCents = (o && o.trade_pl_cents !== undefined) ? o.trade_pl_cents : null;
  const tradeCell = td(`num ${sharedKalshiPnlClass(tradePlCents)}`,
   tradePlCents === null || tradePlCents === undefined
    ? 'No position closed by this order (opening/adding, resting, or canceled).'
    : `Realized by closing position \u00B7 avg-cost basis \u00B7 Estimated ${estimatedPnl} \u00B7 Position realized ${realizedPnl} \u00B7 Open ${openValueText}`);
  tradeCell.textContent = formatSharedKalshiPnlCentsOrDash(tradePlCents);
  tr.appendChild(tradeCell);

  // SETTLE P&L: realized by holding to resolution. It belongs to the position
  // that survived to settlement, not to any one fill, so it rides its own
  // settlement row at the foot of the tape \u2014 order rows never carry it.
  const settleCell = td('num pnl-none', 'Settlement P&L is reported on the settlement row for this market.');
  settleCell.textContent = '\u2014';
  tr.appendChild(settleCell);

  const feeCents = (o && o.fees_cents !== undefined) ? o.fees_cents : null;
  const feeCell = td('num khist-fee',
   feeCents === null || feeCents === undefined
    ? 'Fee not reported by Kalshi for this order.'
    : 'Trading fees on this order (never folded into P&L).');
  feeCell.textContent = (feeCents === null || feeCents === undefined)
   ? '\u2014'
   : `$${(Math.abs(Math.round(Number(feeCents))) / 100).toFixed(2)}`;
  tr.appendChild(feeCell);

  const resultParts = sharedKalshiResultStateParts(o && o.result_state);
  const resultCell = td('', resultParts.title);
  const resultSpan = document.createElement('span');
  resultSpan.className = resultParts.cls;
  resultSpan.textContent = resultParts.text;
  resultCell.appendChild(resultSpan);
  if (o && Number(o.data_gap_qty) > 0) {
   const gapSpan = document.createElement('span');
   gapSpan.className = 'khist-gap-qty';
   gapSpan.textContent = `${Math.round(Number(o.data_gap_qty))} unmatched`;
   resultCell.appendChild(gapSpan);
  }
  tr.appendChild(resultCell);

  const statusCell = td('khist-status');
  const statusFlag = document.createElement('span');
  statusFlag.className = `flag${statusRaw === 'executed' ? ' ok' : (statusRaw === 'resting' ? ' warn' : '')}`;
  statusFlag.textContent = (statusRaw || 'unknown').toUpperCase();
  statusCell.appendChild(statusFlag);
  // Market-settlement state chip only while it adds info (settled YES/NO is
  // already reflected by WIN/LOSE in the RESULT column).
  if (matchTag === 'WAIT' || matchTag === 'LIVE' || matchTag === 'END' || matchTag === 'UNK') {
   const matchFlag = document.createElement('span');
   matchFlag.className = 'flag dim';
   matchFlag.textContent = matchTag;
   statusCell.appendChild(matchFlag);
  }
  tr.appendChild(statusCell);

  const canShowOrderAction = (
   orderId !== 'N/A' &&
   typeof opts.onOrderAction === 'function' &&
   (
    (
     !heldSuppressedByDuplicateTicker &&
     (statusRaw === 'resting' || statusRaw === 'executed') &&
     effectiveRemainingQty > 0
    ) ||
    (
     !heldSuppressedByDuplicateTicker &&
     (statusRaw === 'resting' || statusRaw === 'executed' || statusRaw === 'canceled') &&
     heldQty > 0
    )
   )
  );

  const orderCell = td('khist-oid-cell');
  if (canShowOrderAction) {
   const orderIdBtn = document.createElement('button');
   orderIdBtn.type = 'button';
   orderIdBtn.className = 'kalshi-order-id-action-btn khist-oid';
   orderIdBtn.textContent = orderId;
   orderIdBtn.title = `${orderId} \u00B7 ${String(opts.orderActionTitle || 'Cancel remaining or sell held @ ask')}`;
   orderIdBtn.addEventListener('click', () => {
    void opts.onOrderAction({
     order: o,
     index: idx,
     holdingsMap,
     effectiveHeldQty,
     effectiveRemainingQty,
    });
   });
   orderCell.appendChild(orderIdBtn);
  } else {
   const orderIdText = document.createElement('span');
   orderIdText.className = 'kalshi-order-id-text khist-oid';
   orderIdText.textContent = orderId;
   orderIdText.title = orderId;
   orderCell.appendChild(orderIdText);
  }
  tr.appendChild(orderCell);

  tbody.appendChild(tr);
 });

 appendSharedKalshiOrderHistoryRollup(tbody, td, opts);
 normalizeSharedKalshiOrderHistoryNodeText(listEl);
}

// Foot of the tape: one settlement row per position that survived to resolution,
// then one rollup row per market. The rollup is the figure that reconciles
// against Kalshi's own position-level P&L; the order rows above it explain how
// it was earned.
function appendSharedKalshiOrderHistoryRollup(tbody, td, opts) {
 const settleRows = Array.isArray(opts.settleRows) ? opts.settleRows : [];
 const rollupMap = (opts.rollupByTicker && typeof opts.rollupByTicker === 'object')
  ? opts.rollupByTicker
  : {};
 const rollupRows = Object.keys(rollupMap)
  .map((k) => rollupMap[k])
  .filter((r) => r && typeof r === 'object')
  .sort((a, b) => String(a.ticker || '').localeCompare(String(b.ticker || '')));
 if (settleRows.length === 0 && rollupRows.length === 0) return;

 const cents = (v) => formatSharedKalshiPnlCentsOrDash(v);
 const priceText = (v) => (v === null || v === undefined || !Number.isFinite(Number(v)))
  ? '—'
  : `${Number(v).toFixed(1)}¢`;

 settleRows.forEach((s) => {
  const qty = Math.round(Number(s.qty) || 0);
  if (!qty) return;
  const parts = deriveSharedKalshiOrderMatchParts(s.ticker);
  const tr = document.createElement('tr');
  tr.className = 'khist-settle-row';
  const timeCell = td('khist-time');
  timeCell.textContent = 'settle';
  tr.appendChild(timeCell);
  const sideCell = td();
  const span = document.createElement('span');
  span.className = 't-act settle';
  span.textContent = 'SETTLE';
  sideCell.appendChild(span);
  tr.appendChild(sideCell);
  const matchCell = td('khist-match', String(s.ticker || ''));
  matchCell.textContent = parts.outcome ? `${parts.code} ${parts.outcome}` : parts.code;
  tr.appendChild(matchCell);
  const fillCell = td('num', 'Average cost basis of the position held into resolution');
  fillCell.textContent = `${String(s.side || '').toUpperCase()} ${priceText(s.avg_cost_cents)}`;
  tr.appendChild(fillCell);
  const payoutCell = td('num');
  payoutCell.textContent = `${Math.round(Number(s.payout_cents) || 0)}¢`;
  tr.appendChild(payoutCell);
  const qtyCell = td('num');
  qtyCell.textContent = String(qty);
  tr.appendChild(qtyCell);
  tr.appendChild(td('num')).textContent = '—';
  const tradeCell = td('num pnl-none', 'Settlement realizes no trade P&L.');
  tradeCell.textContent = '—';
  tr.appendChild(tradeCell);
  const settleCell = td(`num ${sharedKalshiPnlClass(s.settle_pl_cents)}`,
   `(payout ${Math.round(Number(s.payout_cents) || 0)}¢ − avg cost ${priceText(s.avg_cost_cents)}) × ${qty}`);
  settleCell.textContent = cents(s.settle_pl_cents);
  tr.appendChild(settleCell);
  tr.appendChild(td('num')).textContent = '—';
  const settleState = Number(s.settle_pl_cents) > 0
   ? 'SETTLED_WIN'
   : (Number(s.settle_pl_cents) < 0 ? 'SETTLED_LOSS' : 'SETTLED_FLAT');
  const settleParts = sharedKalshiResultStateParts(settleState);
  const resultCell = td('', settleParts.title);
  const rspan = document.createElement('span');
  rspan.className = settleParts.cls;
  rspan.textContent = settleParts.text;
  resultCell.appendChild(rspan);
  tr.appendChild(resultCell);
  tr.appendChild(td('khist-status')).textContent = '';
  tr.appendChild(td('khist-oid-cell')).textContent = '';
  tbody.appendChild(tr);
 });

 rollupRows.forEach((r) => {
  const parts = deriveSharedKalshiOrderMatchParts(r.ticker);
  const tr = document.createElement('tr');
  tr.className = 'khist-rollup-row';
  const timeCell = td('khist-time');
  timeCell.textContent = 'total';
  tr.appendChild(timeCell);
  const sideCell = td();
  const span = document.createElement('span');
  span.className = 't-act rollup';
  span.textContent = 'MATCH';
  sideCell.appendChild(span);
  tr.appendChild(sideCell);
  const matchCell = td('khist-match', String(r.ticker || ''));
  matchCell.textContent = parts.outcome ? `${parts.code} ${parts.outcome}` : parts.code;
  tr.appendChild(matchCell);
  const entryCell = td('num', 'Average entry price across all buys');
  entryCell.textContent = priceText(r.avg_entry_cents);
  tr.appendChild(entryCell);
  const exitCell = td('num', 'Average exit price across all sells');
  exitCell.textContent = priceText(r.avg_exit_cents);
  tr.appendChild(exitCell);
  const qtyCell = td('num', `Bought ${r.bought_qty || 0} · Sold ${r.sold_qty || 0} · Open ${r.open_qty || 0}`);
  qtyCell.textContent = `${r.bought_qty || 0}/${r.sold_qty || 0}`;
  tr.appendChild(qtyCell);
  tr.appendChild(td('num')).textContent = '—';
  const tradeCell = td(`num ${sharedKalshiPnlClass(r.trade_pl_cents)}`, 'Realized closing positions before resolution');
  tradeCell.textContent = cents(r.trade_pl_cents);
  tr.appendChild(tradeCell);
  const settleCell = td(`num ${sharedKalshiPnlClass(r.settle_pl_cents)}`, 'Realized holding to resolution');
  settleCell.textContent = cents(r.settle_pl_cents);
  tr.appendChild(settleCell);
  const feeCell = td('num khist-fee', 'Total trading fees on this market');
  feeCell.textContent = (r.fees_cents === null || r.fees_cents === undefined)
   ? '—'
   : `$${(Math.abs(Math.round(Number(r.fees_cents))) / 100).toFixed(2)}`;
  tr.appendChild(feeCell);
  const gapQty = Math.round(Number(r.data_gap_qty) || 0);
  const netCell = gapQty > 0
   ? td('khist-net r-gap',
      `${gapQty} sold contracts have no matching inventory in this market’s fill history. `
      + 'They are excluded from P&L, so this NET is incomplete.')
   : td(`khist-net ${sharedKalshiPnlClass(r.net_pl_cents)}`, 'Trade + Settle − Fees');
  netCell.textContent = gapQty > 0 ? `DATA GAP ${cents(r.net_pl_cents)}` : `NET ${cents(r.net_pl_cents)}`;
  tr.appendChild(netCell);
  tr.appendChild(td('khist-status')).textContent = '';
  tr.appendChild(td('khist-oid-cell')).textContent = '';
  tbody.appendChild(tr);
 });
}
 </script>
